generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  seller
  admin
}

enum UserStatus {
  active
  blocked
  pending
}

enum ListingStatus {
  draft
  pending_review
  approved
  auction_requested
  rejected
  sold
}

enum WatchCondition {
  new
  excellent
  good
  fair
}

enum AuctionStatus {
  scheduled
  live
  ended
  cancelled
}

enum BidStatus {
  active
  outbid
  winning
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

model User {
  id    BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name  String  @db.VarChar(150)
  email String? @unique @db.VarChar(150)
  phone String? @unique @db.VarChar(30)

  otpCode      String?   @map("otp_code")
  otpExpiresAt DateTime? @map("otp_expires_at")

  password String? @db.VarChar(255)

  role   UserRole   @default(user)
  status UserStatus @default(active)

  isVerified     Boolean @default(false) @map("is_verified")
  nafathVerified Boolean @default(false) @map("nafath_verified")

  listings      WatchListing[]
  bids          Bid[]
  watchlists    Watchlist[]
  payments      Payment[]
  notifications Notification[]
  wonAuctions   Auction[]      @relation("AuctionWinner")

  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  sellerContractAcceptances SellerContractAcceptance[]
  DeviceToken               DeviceToken[]

  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]

  @@map("users")
}

model WatchBrand {
  id     BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  nameEn String  @map("name_en") @db.VarChar(150)
  nameAr String? @map("name_ar") @db.VarChar(150)
  slug   String  @unique @db.VarChar(150)
  status Boolean @default(true)

  listings WatchListing[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("watch_brands")
}

model WatchListing {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  sellerId BigInt @map("seller_id") @db.UnsignedBigInt
  brandId  BigInt @map("brand_id") @db.UnsignedBigInt

  title           String  @db.VarChar(255)
  referenceNumber String? @map("reference_number") @db.VarChar(100)
  productionYear  Int?    @map("production_year")

  conditionStatus WatchCondition @default(excellent) @map("condition_status")

  hasOriginalBox    Boolean @default(false) @map("has_original_box")
  hasPapers         Boolean @default(false) @map("has_papers")
  hasServiceHistory Boolean @default(false) @map("has_service_history")

  description String? @db.Text

  reservePrice   Decimal? @map("reserve_price") @db.Decimal(12, 2)
  estimatedPrice Decimal? @map("estimated_price") @db.Decimal(12, 2)

  status ListingStatus @default(draft)

  seller User       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  brand  WatchBrand @relation(fields: [brandId], references: [id], onDelete: Restrict)

  images  WatchImage[]
  auction Auction?

  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  sellerContractAcceptances SellerContractAcceptance[]

  @@index([sellerId])
  @@index([brandId])
  @@map("watch_listings")
}

model WatchImage {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  watchListingId BigInt @map("watch_listing_id") @db.UnsignedBigInt
  imageUrl       String @map("image_url") @db.VarChar(500)
  sortOrder      Int    @default(0) @map("sort_order")

  listing WatchListing @relation(fields: [watchListingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([watchListingId])
  @@map("watch_images")
}

model Auction {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  watchListingId BigInt @unique @map("watch_listing_id") @db.UnsignedBigInt

  startPrice   Decimal  @map("start_price") @db.Decimal(12, 2)
  currentPrice Decimal? @map("current_price") @db.Decimal(12, 2)
  bidIncrement Decimal  @default(1000.00) @map("bid_increment") @db.Decimal(12, 2)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  status AuctionStatus @default(scheduled)

  winnerUserId BigInt? @map("winner_user_id") @db.UnsignedBigInt

  listing WatchListing @relation(fields: [watchListingId], references: [id], onDelete: Cascade)
  winner  User?        @relation("AuctionWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)

  bids       Bid[]
  watchlists Watchlist[]
  payments   Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
  @@map("auctions")
}

model Bid {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  auctionId BigInt @map("auction_id") @db.UnsignedBigInt
  userId    BigInt @map("user_id") @db.UnsignedBigInt

  amount Decimal @db.Decimal(12, 2)

  status BidStatus @default(active)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([auctionId, amount])
  @@index([userId])
  @@map("bids")
}

model Watchlist {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  userId    BigInt @map("user_id") @db.UnsignedBigInt
  auctionId BigInt @map("auction_id") @db.UnsignedBigInt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, auctionId])
  @@map("watchlists")
}

model Payment {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  auctionId BigInt @map("auction_id") @db.UnsignedBigInt
  userId    BigInt @map("user_id") @db.UnsignedBigInt

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("SAR") @db.VarChar(10)

  provider      String? @db.VarChar(50)
  transactionId String? @map("transaction_id") @db.VarChar(255)

  status PaymentStatus @default(pending)

  paidAt DateTime? @map("paid_at")

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([auctionId])
  @@index([userId])
  @@map("payments")
}

model Notification {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  userId BigInt @map("user_id") @db.UnsignedBigInt

  title String  @db.VarChar(255)
  body  String? @db.Text

  type String? @db.VarChar(100)
  data Json?

  isRead Boolean @default(false) @map("is_read")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model SellerContractAcceptance {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  sellerId  BigInt  @map("seller_id") @db.UnsignedBigInt
  listingId BigInt? @map("listing_id") @db.UnsignedBigInt

  contractVersion String  @map("contract_version") @db.VarChar(50)
  contractPdfUrl  String? @map("contract_pdf_url") @db.VarChar(500)
  commissionRate  Decimal @map("commission_rate") @db.Decimal(5, 2)

  isAccepted Boolean  @default(true) @map("is_accepted")
  acceptedAt DateTime @default(now()) @map("accepted_at")

  ipAddress  String? @map("ip_address") @db.VarChar(100)
  deviceInfo String? @map("device_info") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller  User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  listing WatchListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([listingId])
  @@map("seller_contract_acceptances")
}

model DeviceToken {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  userId BigInt @map("user_id") @db.UnsignedBigInt

  token    String  @unique @db.VarChar(191)
  platform String? @db.VarChar(50)

  isActive Boolean @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_tokens")
}

model HomeBanner {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title       String
  subtitle    String?
  buttonText  String?
  imageUrl    String
  actionType  String   @default("auctions")
  actionValue String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("home_banners")
}

model Package {
  id                 BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  name               String
  description        String? @db.Text
  price              Decimal @db.Decimal(10, 2)
  durationDays       Int
  maxListings        Int?
  maxAuctionRequests Int?
  featuredListings   Int?
  maxBids            Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("packages")
}

model Subscription {
  id        BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt
  packageId BigInt

  startDate DateTime
  endDate   DateTime
  status    String   @default("active")

  maxListings        Int?
  maxAuctionRequests Int?
  featuredListings   Int?
  maxBids            Int?

  usedListings         Int @default(0)
  usedAuctionRequests  Int @default(0)
  usedFeaturedListings Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  payments SubscriptionPayment[]

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

  subscriptionId BigInt @map("subscription_id") @db.UnsignedBigInt
  userId         BigInt @map("user_id") @db.UnsignedBigInt

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("SAR") @db.VarChar(10)

  provider      String? @db.VarChar(50)
  transactionId String? @map("transaction_id") @db.VarChar(255)

  status PaymentStatus @default(pending)

  paidAt DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@map("subscription_payments")
}
